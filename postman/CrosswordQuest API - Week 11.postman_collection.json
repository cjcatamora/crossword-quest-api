      "name": "Module 2 - Sessions and joining",
      "item": [
        {
          "name": "01 Host starts a game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "     pm.test(\"status is 201\", function () {\r\n       pm.response.to.have.status(201);\r\n     });\r\n     if (pm.response.code === 201) {\r\n       pm.collectionVariables.set(\"code\", pm.response.json().code);\r\n     }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "{{host}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"set_id\": 1 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            }
          },
          "response": []
        },
        {
